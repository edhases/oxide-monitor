// Oxide Monitor Windows resources.
//
// This file is not compiled by Cargo yet (there is no build.rs); see
// docs/BUILD.md for how to embed it in a future build script.
//
// Resource paths below are resolved from rc.exe's working directory (or its
// /I include directories). Run rc.exe from resources/ or pass /I resources.

#include <windows.h>

// RT_MANIFEST = 24
1 24 "app.manifest"

// Main application / tray icon. ID 1 is conventional for MAKEINTRESOURCEW(1).
1 ICON "oxide.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Oxide Monitor contributors"
            VALUE "FileDescription", "Oxide Monitor taskbar system monitor"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "oxide-monitor"
            VALUE "LegalCopyright", "Copyright (c) Oxide Monitor contributors. MIT OR Apache-2.0."
            VALUE "OriginalFilename", "oxide-monitor.exe"
            VALUE "ProductName", "Oxide Monitor"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
